  "forms": {
    "tour": {
      "required": [
        "guestName",
        "serviceId",
        "date",
        "adults"
      ],
      "optional": [
        "roomNumber",
        "children0to3",
        "children4to6",
        "phone",
        "notes"
      ]
    },
    "transfer": {
      "required": [
        "guestName",
        "serviceId",
        "date",
        "time",
        "pickupLocation",
        "dropoffLocation",
        "passengerCount"
      ],
      "optional": [
        "roomNumber",
        "flightNumber",
        "luggageCount",
        "vehiclePreference",
        "phone",
        "notes"
      ]
    }
  },
  "booking": {
    "method": "whatsapp_click_to_chat",
    "requiresGuestToPressSend": true,
    "messageTemplate": "KA Hotel & Suites — Reservation Request\nService: {serviceTitle}\nGuest: {guestName}\nDate: {date}\nDetails: {details}\nPlease confirm availability and price.",
    "childPricing": {
      "freeAgeRange": "0-3",
      "discountAgeRange": "4-6",
      "discountPercent": 30,
      "appliesTo": "per_person_priced_tours",
      "note": "Estimated total; final amount confirmed by hotel"
    }
  }
